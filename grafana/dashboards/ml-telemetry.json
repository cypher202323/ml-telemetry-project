{
  "title": "ML Telemetry Dashboard",
  "uid": "ml-telemetry",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries", "title": "Request rate (requests per second)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "/predict",
        "expr": "sum(rate(api_requests_total{endpoint=\"/predict\"}[1m]))" }]
    },
    {
      "type": "timeseries", "title": "Response time (milliseconds)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "95th percentile",
          "expr": "histogram_quantile(0.95, sum(rate(api_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])) by (le)) * 1000" },
        { "refId": "B", "legendFormat": "Average",
          "expr": "sum(rate(api_request_duration_seconds_sum{endpoint=\"/predict\"}[1m])) / sum(rate(api_request_duration_seconds_count{endpoint=\"/predict\"}[1m])) * 1000" }
      ]
    },
    {
      "type": "timeseries", "title": "Error rate (%)",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "Errors",
        "expr": "(sum(rate(api_request_errors_total[1m])) or vector(0)) / sum(rate(api_requests_total[1m])) * 100" }]
    },
    {
      "type": "timeseries", "title": "CPU usage per container (%)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])) * 100" }]
    },
    {
      "type": "timeseries", "title": "Memory usage per container",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})" }]
    }
  ]
}